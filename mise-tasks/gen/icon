#!/usr/bin/env bash
#MISE description="Generate the macOS Fleet icon from assets/fleet-logo.png"
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
resources="$root/apps/fleet/resources"
scratch="$(mktemp -d)"
iconset="$scratch/Fleet.iconset"
trap 'rm -rf "$scratch"' EXIT
mkdir -p "$resources" "$iconset"
uv run --with pillow --with numpy python "$root/mise-tasks/gen/icon.py" "$root/assets/fleet-logo.png" "$resources/Fleet.png" "$iconset"
iconutil -c icns "$iconset" -o "$resources/Fleet.icns"
