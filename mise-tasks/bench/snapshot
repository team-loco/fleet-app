#!/usr/bin/env bash
#MISE description="Check Fleet's synthetic snapshot timing and allocation budgets in release mode"
set -euo pipefail
timing_status=0
mise exec -- cargo test -p fleet-kube --release --test performance synthetic -- --ignored --nocapture --test-threads=1 || timing_status=$?
mise exec -- cargo test -p fleet-kube --release --test performance_heap synthetic -- --ignored --nocapture --test-threads=1
exit "${timing_status}"
