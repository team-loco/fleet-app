#!/usr/bin/env bash
#MISE description="Prove Flock works against the kind scenario clusters: up, verify, run every FLOCK_E2E test"
#USAGE flag "--skip-up" help="Do not create or reapply the clusters; require them to exist"
#USAGE flag "--no-teardown" help="Keep the clusters after the run (the default outside CI)"
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CLUSTERS=(fleet-a fleet-b)
skip_up="${usage_skip_up:-false}"
no_teardown="${usage_no_teardown:-false}"

teardown() {
  if [[ "${no_teardown}" != true && -n "${CI:-}" ]]; then
    "${ROOT}/mise-tasks/e2e/down"
  fi
}
work_dir="$(mktemp -d)"
trap 'rm -rf "${work_dir}"; teardown' EXIT

if [[ "${skip_up}" != true ]]; then
  "${ROOT}/mise-tasks/e2e/up"
fi

kubeconfigs=()
for cluster in "${CLUSTERS[@]}"; do
  file="${work_dir}/${cluster}.kubeconfig"
  mise exec -- kind get kubeconfig --name "${cluster}" >"${file}"
  kubeconfigs+=("${file}")
done
KUBECONFIG="$(IFS=:; printf '%s' "${kubeconfigs[*]}")"
export KUBECONFIG
export FLOCK_E2E=1

"${ROOT}/e2e/verify"

cd "${ROOT}"
mise exec -- cargo nextest run --workspace --no-tests=pass
mise exec -- cargo nextest run --workspace --no-tests=pass --features flock/loco
