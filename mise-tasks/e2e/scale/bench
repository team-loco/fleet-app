#!/usr/bin/env bash
#MISE description="Measure Flock's scale watcher heap, rebuilds and API-to-UI-state latency"
set -euo pipefail
export FLOCK_E2E=1
timing_status=0
mise exec -- cargo test -p flock-kube --release --test performance kind_scale -- --ignored --nocapture --test-threads=1 || timing_status=$?
mise exec -- cargo test -p flock-kube --release --test performance_heap kind_scale -- --ignored --nocapture --test-threads=1
exit "${timing_status}"
