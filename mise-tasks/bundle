#!/usr/bin/env bash
#MISE description="Build and ad-hoc sign dist/Flock.app"
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
cargo bundle --release --package flock --format osx "$@"
mkdir -p "$root/dist"
rm -rf "$root/dist/Flock.app"
ditto "$root/target/release/bundle/osx/Flock.app" "$root/dist/Flock.app"
plist="$root/dist/Flock.app/Contents/Info.plist"
version="$(plutil -extract CFBundleShortVersionString raw "$plist")"
/usr/libexec/PlistBuddy -c "Set :CFBundleVersion $version" "$plist"
codesign --force --deep -s - "$root/dist/Flock.app"
codesign --verify --deep --strict "$root/dist/Flock.app"
echo "$root/dist/Flock.app"
