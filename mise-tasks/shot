#!/usr/bin/env bash
#MISE description="Screenshot a demo screen: mise run shot -- <screen> [dark|light]"
#USAGE arg "<screen>" help="fleet, cluster, collapsed, command, changes, kit, kit-overlays or kit-panes"
#USAGE arg "[appearance]" default="dark" help="dark or light"
set -euo pipefail

screen="${usage_screen:-${1:?screen}}"
appearance="${usage_appearance:-${2:-dark}}"
root="$(git rev-parse --show-toplevel)"
out="$root/target/shots/$screen-$appearance.png"
helper="$root/target/shots/window-id"
wait_steps=100
settle_seconds=1.5

mkdir -p "$root/target/shots"
cargo build -p fleet --quiet ${FLEET_FEATURES:+--features "$FLEET_FEATURES"}
if [[ ! -x "$helper" || "$root/mise-tasks/window-id.swift" -nt "$helper" ]]; then
  swiftc -O -o "$helper" "$root/mise-tasks/window-id.swift"
fi

"$root/target/debug/fleet" --demo --screen "$screen" --appearance "$appearance" &
pid=$!
trap 'kill "$pid" 2>/dev/null || true' EXIT

window=""
for _ in $(seq "$wait_steps"); do
  if window="$("$helper" "$pid")"; then
    break
  fi
  sleep 0.1
done
if [[ -z "$window" ]]; then
  echo "no window for fleet (pid $pid)" >&2
  exit 1
fi

sleep "$settle_seconds"
screencapture -x -o -l "$window" "$out"
echo "$out"
