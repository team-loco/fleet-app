#!/usr/bin/env bash
#MISE description="Render a demo screen to a PNG headlessly: mise run shot -- <screen> [dark|light]"
#USAGE arg "<screen>" help="fleet, cluster, collapsed, command, changes, compare, cluster-settings, gitops, overview, nodes, namespaces, events, resources, kit, kit-overlays, kit-panes, add-cluster, add-cluster-check, workload, pods, pods-shell, kustomization, helmrelease or source; with FLEET_FEATURES=loco also loco-platform, loco-apps, loco-builds or loco-routes"
#USAGE arg "[appearance]" default="dark" help="dark or light"
set -euo pipefail

screen="${usage_screen:-${1:?screen}}"
appearance="${usage_appearance:-${2:-dark}}"
root="$(git rev-parse --show-toplevel)"
out="$root/target/shots/$screen-$appearance.png"

cargo run -p fleet-shots --quiet ${FLEET_FEATURES:+--features "$FLEET_FEATURES"} -- "$screen" "$appearance" --out "$out"
